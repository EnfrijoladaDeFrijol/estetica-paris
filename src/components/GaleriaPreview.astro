---
/* GaleriaPreview — Carrusel infinito estilo mosaico para index.astro */
import { Image } from 'astro:assets';

const imagesGlob = import.meta.glob('../assets/images/galeria/*.{jpeg,jpg,png,webp}', { eager: true });

const galeriaItems = Object.entries(imagesGlob)
    .sort(([pathA], [pathB]) => {
        const numA = parseInt(pathA.match(/\/(\d+)\./)?.[1] || '0');
        const numB = parseInt(pathB.match(/\/(\d+)\./)?.[1] || '0');
        return numA - numB;
    })
    .map(([path, img], index) => ({
        src: (img as any).default,
        titulo: `Estilo ${index + 1}`
    }));

/* Dividimos en 2 filas para el mosaico */
const mitad = Math.ceil(galeriaItems.length / 2);
const fila1 = galeriaItems.slice(0, mitad);
const fila2 = galeriaItems.slice(mitad);
---

<section class="relative py-20 md:py-28 overflow-hidden section-glow-top" id="galeria">

    <!-- Título de sección -->
    <div class="px-6 md:px-0 max-w-6xl mx-auto text-center mb-8 md:mb-12" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl lg:text-6xl text-gradient leading-tight mb-5">
            Nuestro Trabajo
        </h2>
        <p class="text-gray-400 max-w-xl mx-auto text-base md:text-lg font-light leading-relaxed">
            Cada corte es una pieza única. Descubre el nivel de detalle y precisión que nos distingue.
        </p>
    </div>

    <!-- Carrusel mosaico infinito -->
    <div class="carousel-mosaic" data-aos="fade-up" data-aos-delay="100">

        <!-- Fila 1 — se mueve a la izquierda -->
        <div class="carousel-row" id="carouselRow1">
            <div class="carousel-track track-left">
                {/* Set original + duplicados para loop infinito */}
                {[...fila1, ...fila1, ...fila1].map((item, i) => (
                    <div class={`carousel-tile ${i % 3 === 0 ? 'tile-wide' : i % 5 === 0 ? 'tile-tall' : ''}`}>
                        <Image
                            src={item.src}
                            alt={item.titulo}
                            width={500}
                            height={400}
                            format="webp"
                            quality={80}
                            class="carousel-tile-img"
                        />
                        <div class="carousel-tile-glow"></div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Fila 2 — se mueve a la derecha (dirección opuesta) -->
        <div class="carousel-row" id="carouselRow2">
            <div class="carousel-track track-right">
                {[...fila2, ...fila2, ...fila2].map((item, i) => (
                    <div class={`carousel-tile ${i % 4 === 0 ? 'tile-wide' : i % 3 === 1 ? 'tile-tall' : ''}`}>
                        <Image
                            src={item.src}
                            alt={item.titulo}
                            width={500}
                            height={400}
                            format="webp"
                            quality={80}
                            class="carousel-tile-img"
                        />
                        <div class="carousel-tile-glow"></div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Fade edges -->
        <div class="carousel-fade-left"></div>
        <div class="carousel-fade-right"></div>
    </div>

    <!-- CTA — Ver galería completa -->
    <div class="px-6 md:px-0 text-center mt-8 md:mt-12" data-aos="fade-up" data-aos-delay="200">
        <a href="/galeria" class="glass-btn">
            <span>Ver Galería Completa</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
        </a>
    </div>

</section>

<style>
    /* ══════════════════════════════════════
       CARRUSEL MOSAICO — Contenedor
       ══════════════════════════════════════ */
    .carousel-mosaic {
        position: relative;
        width: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        pointer-events: none; /* Deshabilita clicks e interacciones */
    }

    .carousel-row {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    /* ══════════════════════════════════════
       TRACK — Fila de tiles
       ══════════════════════════════════════ */
    .carousel-track {
        display: flex;
        gap: 0.5rem;
        width: max-content;
        will-change: transform;
    }

    .track-left {
        animation: scrollLeft 45s linear infinite;
    }

    .track-right {
        animation: scrollRight 50s linear infinite;
    }

    @keyframes scrollLeft {
        0% { transform: translateX(0); }
        100% { transform: translateX(-33.333%); }
    }

    @keyframes scrollRight {
        0% { transform: translateX(-33.333%); }
        100% { transform: translateX(0); }
    }

    /* ══════════════════════════════════════
       TILES — Mosaico de diferentes tamaños
       ══════════════════════════════════════ */
    .carousel-tile {
        position: relative;
        flex-shrink: 0;
        width: 200px;
        height: 140px;
        border-radius: 0.85rem;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }

    /* Variantes de tamaño para efecto mosaico */
    .carousel-tile.tile-wide {
        width: 280px;
    }

    .carousel-tile.tile-tall {
        height: 155px;
    }

    .carousel-tile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Glow sutil en cada tile */
    .carousel-tile-glow {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.3) 0%,
            transparent 50%
        );
        pointer-events: none;
        border-radius: inherit;
    }

    /* ══════════════════════════════════════
       FADE EDGES — Desvanecimiento lateral
       ══════════════════════════════════════ */
    .carousel-fade-left,
    .carousel-fade-right {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 80px;
        z-index: 10;
        pointer-events: none;
    }

    .carousel-fade-left {
        left: 0;
        background: linear-gradient(to right,
            var(--bg-body, #0e0e0d) 0%,
            transparent 100%);
    }

    .carousel-fade-right {
        right: 0;
        background: linear-gradient(to left,
            var(--bg-body, #0e0e0d) 0%,
            transparent 100%);
    }

    /* ══════════════════════════════════════
       RESPONSIVE — Tamaños adaptativos
       ══════════════════════════════════════ */

    /* Móvil: tiles más pequeños */
    @media (max-width: 639px) {
        .carousel-tile {
            width: 150px;
            height: 110px;
            border-radius: 0.7rem;
        }

        .carousel-tile.tile-wide {
            width: 210px;
        }

        .carousel-tile.tile-tall {
            height: 125px;
        }

        .carousel-fade-left,
        .carousel-fade-right {
            width: 40px;
        }

        .track-left {
            animation-duration: 35s;
        }
        .track-right {
            animation-duration: 40s;
        }
    }

    /* Tablet */
    @media (min-width: 640px) and (max-width: 1023px) {
        .carousel-tile {
            width: 220px;
            height: 150px;
        }

        .carousel-tile.tile-wide {
            width: 310px;
        }

        .carousel-tile.tile-tall {
            height: 170px;
        }
    }

    /* Desktop grande */
    @media (min-width: 1024px) {
        .carousel-tile {
            width: 260px;
            height: 165px;
        }

        .carousel-tile.tile-wide {
            width: 360px;
        }

        .carousel-tile.tile-tall {
            height: 185px;
        }

        .carousel-fade-left,
        .carousel-fade-right {
            width: 120px;
        }

        .carousel-mosaic {
            gap: 0.65rem;
        }

        .carousel-track {
            gap: 0.65rem;
        }
    }

    /* Ultra-wide */
    @media (min-width: 1440px) {
        .carousel-tile {
            width: 300px;
            height: 180px;
        }

        .carousel-tile.tile-wide {
            width: 420px;
        }

        .carousel-tile.tile-tall {
            height: 200px;
        }

        .carousel-fade-left,
        .carousel-fade-right {
            width: 160px;
        }
    }
</style>

<script is:inline>
(function() {
    /* ═══════════════════════════════════════
       INTERSECTION OBSERVER — Pausar cuando no visible
       Solo anima cuando la sección está en viewport
       ═══════════════════════════════════════ */
    var carousel = document.querySelector('.carousel-mosaic');
    if (!carousel) return;

    var tracks = carousel.querySelectorAll('.carousel-track');

    // Iniciar pausado hasta que sea visible
    tracks.forEach(function(t) {
        t.style.animationPlayState = 'paused';
    });

    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            tracks.forEach(function(t) {
                t.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
            });
        });
    }, { threshold: 0.1 });

    observer.observe(carousel);
})();
</script>
