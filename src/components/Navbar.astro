---
// src/components/Navbar.astro
---
<!-- 1. NAVBAR PRINCIPAL -->
<nav id="navbar" class="fixed w-full z-50 transition-all duration-500 py-4 px-6"
     style="background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; border-bottom: 1px solid transparent; transform: translateZ(0); will-change: backdrop-filter, transform; backface-visibility: hidden;">
    <div class="max-w-6xl mx-auto flex justify-between items-center">

        <!-- Logo con Torre -->
        <a href="/" class="flex items-center gap-3 z-50 group">
            <img src="/images/torre.png" alt="Torre Eiffel" class="w-10 h-10 object-contain opacity-70 group-hover:opacity-100 transition-opacity drop-shadow-[0_0_6px_rgba(212,175,55,0.3)]">
            <span class="text-lg font-bold tracking-[0.2em] text-gradient">ESTÉTICA PARÍS</span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex gap-8 items-center">
            <a href="/#nosotros" class="nav-link text-sm text-[#a8a29e] hover:text-[#e8d48b] transition-all duration-300 tracking-wide">Nosotros</a>
            <a href="/#servicios" class="nav-link text-sm text-[#a8a29e] hover:text-[#e8d48b] transition-all duration-300 tracking-wide">Servicios</a>
            <a href="/#reservas" class="nav-link text-sm text-[#a8a29e] hover:text-[#e8d48b] transition-all duration-300 tracking-wide">Citas</a>
            <a href="/#equipo" class="nav-link text-sm text-[#a8a29e] hover:text-[#e8d48b] transition-all duration-300 tracking-wide">Equipo</a>
            <a href="/#ubicacion" class="nav-link text-sm text-[#a8a29e] hover:text-[#e8d48b] transition-all duration-300 tracking-wide">Ubicación</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-[#a8a29e] p-2 z-50 hover:text-[#e8d48b] transition-colors focus:outline-none" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</nav>

<!-- 2. MENÚ MÓVIL (LIBERADO DEL NAVBAR) -->
<div id="mobile-menu" class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-10 opacity-0 pointer-events-none transition-all duration-500"
     style="background: rgba(17,17,16,0.98);">
    <a href="/#nosotros" class="mobile-link nav-link text-2xl font-light text-[#a8a29e] hover:text-[#d4af37] transition-all tracking-widest">Nosotros</a>
    <a href="/#servicios" class="mobile-link nav-link text-2xl font-light text-[#a8a29e] hover:text-[#d4af37] transition-all tracking-widest">Servicios</a>
    <a href="/#reservas" class="mobile-link nav-link text-2xl font-light text-[#a8a29e] hover:text-[#d4af37] transition-all tracking-widest">Citas</a>
    <a href="/#equipo" class="mobile-link nav-link text-2xl font-light text-[#a8a29e] hover:text-[#d4af37] transition-all tracking-widest">Equipo</a>
    <a href="/#ubicacion" class="mobile-link nav-link text-2xl font-light text-[#a8a29e] hover:text-[#d4af37] transition-all tracking-widest">Ubicación</a>
</div>

<!-- 3. LÓGICA DE ANIMACIÓN Y SCROLL -->
<script is:inline>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');
    let isOpen = false;

    function toggleMenu() {
        isOpen = !isOpen;
        if (isOpen) {
            menu.classList.remove('opacity-0', 'pointer-events-none');
            menu.classList.add('opacity-100', 'pointer-events-auto');
            document.body.style.overflow = 'hidden';
            btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>`;
        } else {
            menu.classList.add('opacity-0', 'pointer-events-none');
            menu.classList.remove('opacity-100', 'pointer-events-auto');
            document.body.style.overflow = '';
            btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>`;
        }
    }

    btn.addEventListener('click', toggleMenu);
    links.forEach(link => link.addEventListener('click', toggleMenu));

    // Scroll handler: transparent at top → dark glass on scroll
    window.addEventListener('scroll', () => {
        const nav = document.getElementById('navbar');
        const scrollY = window.scrollY;
        // Smooth interpolation over 0–100px of scroll
        const progress = Math.min(scrollY / 100, 1);

        if (progress <= 0) {
            // Fully transparent at top
            nav.style.background = 'transparent';
            nav.style.backdropFilter = 'none';
            nav.style.webkitBackdropFilter = 'none';
            nav.style.borderBottomColor = 'transparent';
            nav.style.boxShadow = 'none';
        } else {
            // Interpolate opacity from 0 to 0.88
            const bgOpacity = (0.88 * progress).toFixed(3);
            const blurAmount = Math.round(12 * progress);
            const borderOpacity = (0.1 * progress).toFixed(3);
            const shadowOpacity = (0.3 * progress).toFixed(3);

            nav.style.background = `rgba(17,17,16,${bgOpacity})`;
            nav.style.backdropFilter = `blur(${blurAmount}px) saturate(${1 + 0.3 * progress})`;
            nav.style.webkitBackdropFilter = `blur(${blurAmount}px) saturate(${1 + 0.3 * progress})`;
            nav.style.borderBottomColor = `rgba(212,175,55,${borderOpacity})`;
            nav.style.boxShadow = `0 4px 30px rgba(0,0,0,${shadowOpacity})`;
        }
    });

    // Lógica robusta para resaltar el enlace activo según el scroll
    document.addEventListener('DOMContentLoaded', () => {
        const navLinks = document.querySelectorAll('.nav-link');
        const sections = Array.from(navLinks).map(link => {
            const href = link.getAttribute('href');
            const id = href.includes('#') ? href.split('#')[1] : null;
            return id ? document.getElementById(id) : null;
        }).filter(section => section !== null);

        window.addEventListener('scroll', () => {
            if (sections.length === 0) return;
            
            let current = '';
            const scrollY = window.scrollY;
            
            sections.forEach(section => {
                const sectionTop = section.offsetTop - 150; // Offset para el navbar fijo
                
                // Si el scroll ya pasó el inicio de esta sección
                if (scrollY >= sectionTop) {
                    current = section.getAttribute('id');
                }
            });

            // Caso especial: si llegamos al final absoluto de la página
            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
                current = sections[sections.length - 1].getAttribute('id');
            }

            navLinks.forEach(link => {
                link.classList.remove('!text-[#e8d48b]', 'font-medium');
                link.style.textShadow = 'none';
                if (current && link.getAttribute('href').includes(`#${current}`)) {
                    link.classList.add('!text-[#e8d48b]', 'font-medium');
                    link.style.textShadow = '0 0 12px rgba(232, 212, 139, 0.4)';
                }
            });
        });
    });
</script>

<style>
    @media (max-width: 767px) {
        /* On mobile, keep backdrop-filter disabled for performance.
           Background transitions are handled entirely by the JS scroll handler. */
        #navbar {
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
    }
</style>