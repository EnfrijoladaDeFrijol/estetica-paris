---
// src/components/Hero.astro — Minimalist High-End Spa Look
---

<section class="relative min-h-screen flex items-center justify-center text-center px-6 overflow-hidden">
    
    <!-- Video de fondo con efecto parallax -->
    <div class="absolute inset-0 z-0 overflow-hidden bg-[#111110]">
        <div class="parallax-subtle w-full h-full" data-parallax-absolute="true" data-speed="0.25">
            <video 
                id="hero-video"
                autoplay 
                loop 
                muted 
                playsinline 
                preload="metadata"
                class="hero-video absolute inset-0 w-full h-full object-cover z-0 scale-[1.15]"
                poster="/images/fondo_local.webp"
            >
                <source src="/images/videos/hero_comprimi.mp4" type="video/mp4" />
            </video>
        </div>
    </div>

    <!-- Overlay oscuro elegante — más fuerte para look clínico -->
    <div class="absolute inset-0 z-0 pointer-events-none hero-overlay"></div>

    <!-- Content -->
    <div class="z-10 max-w-3xl flex flex-col items-center" data-aos="fade-up" data-aos-duration="1200">


        <!-- Badge glass -->
        <div class="mb-8 hero-badge flex items-center gap-3" data-aos="fade-down" data-aos-delay="300">
            <span class="hero-badge-line"></span>
            <span class="text-xs tracking-[0.25em] uppercase hero-badge-text" style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 0.85rem; font-weight: 400; letter-spacing: 0.2em;">Líderes en Belleza</span>
            <span class="hero-badge-line"></span>
        </div>

        <!-- Título principal -->
        <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight leading-tight text-gradient" data-aos="fade-up" data-aos-delay="400">
            Alta Peluquería<br class="hidden sm:block"> y Estética.
        </h1>
        
        <!-- Subtítulo descriptivo -->
        <p class="text-lg md:text-xl mb-12 text-[#e8e6e3] font-light max-w-xl leading-loose" data-aos="fade-up" data-aos-delay="500">
            Un espacio diseñado para tu bienestar.<br class="hidden md:block"> Cortes clásicos y tratamientos de belleza premium.
        </p>

        <!-- CTA -->
        <a href="#reservas" class="glass-btn group" data-aos="fade-up" data-aos-delay="600">
            Agendar Cita
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>

        <!-- Decorative line bottom -->
        <div class="hero-line mt-10" data-aos="fade-up" data-aos-delay="700"></div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-[#111110] to-transparent z-10 pointer-events-none"></div>
</section>

<style>
    /* ── Overlay: deep dark with subtle warm tint ── */
    .hero-overlay {
        background:
            linear-gradient(180deg,
                rgba(17,17,16,0.92) 0%,
                rgba(17,17,16,0.78) 40%,
                rgba(17,17,16,0.82) 70%,
                rgba(17,17,16,0.95) 100%
            );
    }

    /* ── Decorative thin line ── */
    .hero-line {
        width: 3rem;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(212,175,55,0.5), transparent);
    }

    /* ── Badge / Slogan ── */
    .hero-badge {
        /* No background or border — clean label */
    }

    .hero-badge-line {
        display: block;
        width: 2rem;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.5), transparent);
    }

    .hero-badge-text {
        background: linear-gradient(135deg, #d4af37 0%, #e8d48b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ── Mobile ── */
    @media (max-width: 767px) {
        .hero-video {
            transform: none !important;
        }
    }
</style>

<script is:inline>
    // Video inteligente: play/pause según visibilidad y conexión para ahorrar recursos
    document.addEventListener('DOMContentLoaded', function() {
        var video = document.getElementById('hero-video');
        if (!video) return;

        var isMobile = window.innerWidth < 768;
        
        // Detectar si hay conexión lenta o modo ahorro de datos
        var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var isSlowConnection = connection && (
            connection.saveData || 
            connection.effectiveType === 'slow-2g' || 
            connection.effectiveType === '2g' || 
            connection.effectiveType === '3g'
        );

        // Pausar el video en conexiones lentas o con ahorro de datos
        if (isSlowConnection) {
            video.pause();
            video.removeAttribute('autoplay');
            // Se mostrará el 'poster' estático que ya tiene el video
            return;
        }

        // Pausar video cuando no es visible (solo si superó el filtro anterior)
        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        video.play().catch(function() {});
                    } else {
                        video.pause();
                    }
                });
            }, { threshold: 0.1 });
            observer.observe(video);
        }
    });
</script>
