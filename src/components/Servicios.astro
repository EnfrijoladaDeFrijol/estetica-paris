                <!-- Item Lista Variable (DSD) -->
                <div class="flex justify-between items-center border-b border-[#78716c]/20 pb-2">
                    <span class="text-[#e8e6e3] font-light flex items-center gap-2">
                        Rayos
                    </span>
                    <div class="text-right">
                        <span class="text-[10px] text-[#78716c] uppercase mr-1">Desde</span>
                        <span class="text-[#e8d48b] font-bold">$950</span>
                    </div>
                </div>

                <div class="flex justify-between items-center border-b border-[#78716c]/20 pb-2">
                    <span class="text-[#e8e6e3] font-light flex items-center gap-2">
