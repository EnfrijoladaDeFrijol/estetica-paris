---
// Productos.astro — Sección "Nuestros Favoritos"
// Diseño: Liquid Glass High-End con paginación integrada
---

<section class="relative py-24 md:py-28 px-4 sm:px-6 overflow-hidden section-glow-top" id="productos">

    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none prod-ambient-glow"
         style="width:800px;height:450px;background:radial-gradient(ellipse,rgba(212,175,55,0.035) 0%,transparent 70%);">
    </div>

    <div class="max-w-6xl mx-auto relative z-10">

        <!-- HEADER -->
        <div class="flex items-end justify-between mb-12" data-aos="fade-up">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-6 h-[1px] bg-gradient-to-r from-transparent to-[#d4af37]/50"></div>
                    <span class="text-[#d4af37] text-xs font-semibold tracking-widest uppercase">Lo que usamos</span>
                </div>
                <h2 class="text-[1.75rem] sm:text-4xl md:text-5xl font-bold text-gradient leading-tight">
                    Nuestros Favoritos
                </h2>
                <p class="text-[#78716c] text-sm mt-3 max-w-sm leading-relaxed">
                    Marcas de confianza internacional para resultados impecables.
                </p>
            </div>
        </div>

        <!-- CARRUSEL WRAPPER -->
        <div class="prod-wrapper relative" data-aos="fade-up" data-aos-delay="100">

            <!-- Fade bordes (controlados por JS) -->
            <div id="prodFadeLeft" class="absolute -left-4 sm:-left-2 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-r from-[#111110] to-transparent z-10 pointer-events-none opacity-0 transition-opacity duration-300"></div>
            <div id="prodFadeRight" class="absolute -right-4 sm:-right-2 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-l from-[#111110] to-transparent z-10 pointer-events-none opacity-0 transition-opacity duration-300"></div>

            <!-- Flecha izquierda -->
            <button id="prodLeft" aria-label="Anterior" class="prod-arrow flex absolute left-1 sm:-left-12 md:-left-16 top-1/2 -translate-y-1/2 z-30 items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/[0.03] backdrop-blur-[24px] backdrop-saturate-[1.4] border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.05)] text-[#d4af37] transition-all duration-300 hover:bg-white/[0.05] hover:border-[#d4af37]/40 hover:scale-105 hover:shadow-[0_8px_32px_rgba(0,0,0,0.35),0_0_20px_rgba(212,175,55,0.2)]">
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>

            <!-- Flecha derecha -->
            <button id="prodRight" aria-label="Siguiente" class="prod-arrow flex absolute right-1 sm:-right-12 md:-right-16 top-1/2 -translate-y-1/2 z-30 items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/[0.03] backdrop-blur-[24px] backdrop-saturate-[1.4] border border-white/[0.08] shadow-[0_8px_32px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.05)] text-[#d4af37] transition-all duration-300 hover:bg-white/[0.05] hover:border-[#d4af37]/40 hover:scale-105 hover:shadow-[0_8px_32px_rgba(0,0,0,0.35),0_0_20px_rgba(212,175,55,0.2)]">
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
            </button>

            <!-- Track scrollable -->
            <div id="prodTrack" class="prod-track">

                <!-- CARD 1 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/1.png"
                             alt="Balsami Presto Treatment" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">TEC ITALY</span>
                        <h3 class="prod-name">Balsami Presto Treatment</h3>
                        <p class="prod-price">$850</p>
                    </div>
                </article>

                <!-- CARD 2 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/2.png"
                             alt="Due Faccetta Massimo" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">TEC ITALY</span>
                        <h3 class="prod-name">Due Faccetta Massimo</h3>
                        <p class="prod-price">$490</p>
                    </div>
                </article>

                <!-- CARD 3 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/3.png"
                             alt="Due Faccetta Pro Treatment" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">TEC ITALY</span>
                        <h3 class="prod-name">Due Faccetta Pro Treatment</h3>
                        <p class="prod-price">$510</p>
                    </div>
                </article>

                <!-- CARD 4 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/4.png"
                             alt="Tonico Shampoo" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">TEC ITALY</span>
                        <h3 class="prod-name">Tonico Shampoo</h3>
                        <p class="prod-price">$290</p>
                    </div>
                </article>

                <!-- CARD 5 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/5.png"
                             alt="Pomegranate Hydration Shampoo" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">HAIRLAB</span>
                        <h3 class="prod-name">Pomegranate Hydration Shampoo</h3>
                        <p class="prod-price">$780</p>
                    </div>
                </article>

                <!-- CARD 6 -->
                <article class="prod-card">
                    <div class="prod-img-wrap">
                        <img src="images/productos/6.png"
                             alt="Hair Mask Wheat Germ" class="prod-img" loading="lazy">
                    </div>
                    <div class="prod-info">
                        <span class="prod-brand">SALERM COSMETICS</span>
                        <h3 class="prod-name">Hair Mask Wheat Germ</h3>
                        <p class="prod-price">$950</p>
                    </div>
                </article>


            </div><!-- /prod-track -->
        </div><!-- /prod-wrapper -->

        <!-- Paginación (Dots ultralimpios) -->
        <div class="flex justify-center items-center gap-3 mt-10" id="prodDots" data-aos="fade-up" data-aos-delay="150">
            <!-- Los dots se generarán vía JS -->
        </div>

        <!-- Nota pie -->
        <p class="text-center text-[11px] text-[#3a3835] mt-8" data-aos="fade-up" data-aos-delay="200">
            Productos sujetos a disponibilidad · Solo para uso en sucursal
        </p>

    </div>
</section>

<style>
    /* ══════════════════════════════════════
       TRACK
       ══════════════════════════════════════ */
    .prod-track {
        display: flex;
        flex-direction: row;
        gap: 1.25rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        padding-bottom: 0.5rem;
        -ms-overflow-style: none;
        scrollbar-width: none;
        cursor: grab;
    }
    .prod-track::-webkit-scrollbar { 
        display: none; 
    }
    .prod-track.is-grabbing { 
        cursor: grabbing; 
    }

    /* ══════════════════════════════════════
       PRODUCT CARD — Liquid Glass Premium
       ══════════════════════════════════════ */
    .prod-card {
        flex-shrink: 0;
        scroll-snap-align: start;
        width: 240px;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px) saturate(1.4);
        -webkit-backdrop-filter: blur(12px) saturate(1.4);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 1rem;
        transform: translateZ(0);
        backface-visibility: hidden;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.25),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        cursor: pointer;
    }

    @media (min-width: 640px) {
        .prod-card { width: 260px; }
    }

    .prod-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(212, 175, 55, 0.35);
        transform: translateY(-6px);
        box-shadow:
            0 20px 50px rgba(0, 0, 0, 0.35),
            0 0 35px rgba(212, 175, 55, 0.1),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* Zona imagen */
    .prod-img-wrap {
        width: 100%;
        height: 240px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        position: relative;
    }

    @media (min-width: 640px) {
        .prod-img-wrap { height: 270px; }
    }

    /* Glow interior sutil al hover */
    .prod-img-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 100%, rgba(212,175,55,0.12) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
        z-index: 1;
    }
    .prod-card:hover .prod-img-wrap::after { opacity: 1; }

    .prod-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        filter: brightness(0.9) saturate(1.05);
    }
    .prod-card:hover .prod-img {
        transform: scale(1.08);
        filter: brightness(1) saturate(1.15);
    }

    /* Zona texto */
    .prod-info {
        padding: 1rem 1.15rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .prod-brand {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #d4af37;
        opacity: 0.9;
        transition: color 0.3s ease;
    }
    .prod-card:hover .prod-brand {
        color: #e8d48b;
    }

    .prod-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        color: #e8e6e3;
        line-height: 1.4;
        margin-top: 0.1rem;
    }

    .prod-price {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #e8d48b;
        margin-top: 0.4rem;
    }

    /* ══════════════════════════════════════
       FLECHAS
       ══════════════════════════════════════ */
    .prod-arrow {
        cursor: pointer;
        outline: none;
        opacity: 0;
        pointer-events: none;
        -webkit-tap-highlight-color: transparent;
    }

    .prod-arrow.visible {
        opacity: 1 !important;
        pointer-events: auto !important;
    }

    .prod-arrow:hover svg {
        filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.5));
    }

    /* ══════════════════════════════════════
       DOTS (Paginación)
       ══════════════════════════════════════ */
    .prod-dot {
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.15);
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .prod-dot:hover {
        background: rgba(212, 175, 55, 0.4);
    }
    .prod-dot.active {
        width: 24px;
        background: rgba(255, 255, 255, 0.1);
    }
    .prod-dot.active::after {
        content: '';
        position: absolute;
        top: 0; left: 0; bottom: 0;
        width: 100%;
        background: #d4af37;
        border-radius: 9999px;
        box-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
    }

    /* Ambient glow blur — solo desktop */
    .prod-ambient-glow {
        filter: blur(100px);
    }

    @media (max-width: 767px) {
        .prod-ambient-glow {
            display: none;
        }
        .prod-card:hover {
            transform: none;
        }
    }
</style>

<script is:inline>
(function () {
    var track  = document.getElementById('prodTrack');
    var btnL   = document.getElementById('prodLeft');
    var btnR   = document.getElementById('prodRight');
    var fadeL  = document.getElementById('prodFadeLeft');
    var fadeR  = document.getElementById('prodFadeRight');
    var dotsContainer = document.getElementById('prodDots');
    var STEP   = 280;

    if (!track) return;

    var cards = track.querySelectorAll('.prod-card');
    var dots = [];

    // Create dots based on total cards
    if (dotsContainer && cards.length > 0) {
        cards.forEach(function(_, i) {
            var dot = document.createElement('div');
            dot.className = 'prod-dot';
            if (i === 0) dot.classList.add('active');
            dot.addEventListener('click', function() {
                var scrollTarget = i * STEP;
                // If it's the last few elements, just scroll to the end
                if (i === cards.length - 1) {
                    scrollTarget = track.scrollWidth;
                }
                track.scrollTo({ left: scrollTarget, behavior: 'smooth' });
            });
            dotsContainer.appendChild(dot);
            dots.push(dot);
        });
    }

    function updateUI() {
        var sl  = track.scrollLeft;
        var sw  = track.scrollWidth;
        var cw  = track.clientWidth;
        var thr = 12;
        var canLeft  = sl > thr;
        var canRight = sl + cw < sw - thr;

        if (btnL) btnL.classList.toggle('visible', canLeft);
        if (btnR) btnR.classList.toggle('visible', canRight);

        if (fadeL) fadeL.style.opacity = canLeft ? '1' : '0';
        if (fadeR) fadeR.style.opacity = canRight ? '1' : '0';

        // Update dots
        if (dots.length > 0) {
            // Calculate active index based on scroll position
            var activeIndex = Math.round(sl / STEP);
            if (activeIndex >= dots.length) activeIndex = dots.length - 1;
            
            dots.forEach(function(dot, i) {
                dot.classList.toggle('active', i === activeIndex);
            });
        }
    }

    track.addEventListener('scroll', updateUI, { passive: true });
    window.addEventListener('resize', updateUI);
    updateUI();
    setTimeout(updateUI, 150);
    setTimeout(updateUI, 500);

    if (btnL) btnL.addEventListener('click', function () { track.scrollBy({ left: -STEP, behavior: 'smooth' }); });
    if (btnR) btnR.addEventListener('click', function () { track.scrollBy({ left:  STEP, behavior: 'smooth' }); });

    var isDown = false, startX, scrollLeft;

    track.addEventListener('mousedown', function (e) {
        isDown = true;
        track.classList.add('is-grabbing');
        startX     = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', function () {
        isDown = false;
        track.classList.remove('is-grabbing');
    });
    track.addEventListener('mouseup', function () {
        isDown = false;
        track.classList.remove('is-grabbing');
    });
    track.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        e.preventDefault();
        var x    = e.pageX - track.offsetLeft;
        var walk = (x - startX) * 1.6;
        track.scrollLeft = scrollLeft - walk;
    });
})();
</script>