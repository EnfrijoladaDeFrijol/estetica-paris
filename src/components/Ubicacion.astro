---
---
<section id="ubicacion" class="relative py-28 md:py-36 px-6 overflow-hidden section-glow-top">
    
    <div class="max-w-5xl mx-auto relative z-10">
        
        <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-4xl md:text-5xl font-bold mb-4 text-gradient">Visítanos</h2>
        </div>

        <!-- Mapa -->
        <div class="glass-panel p-3 md:p-4 rounded-[2rem] overflow-hidden" data-aos="zoom-in" data-aos-duration="1000">
            <div class="relative w-full h-[400px] rounded-2xl overflow-hidden" style="background: rgba(255,255,255,0.02);">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d235.2190800629957!2d-99.15644803254091!3d19.3905625!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1ff06040953eb%3A0xbc712d2b50f6d800!2zRXN0w6l0aWNhIFBhcsOtcw!5e0!3m2!1ses!2smx!4v1787360238785!5m2!1ses!2smx" 
                    class="absolute top-0 left-0 w-full h-full border-0 opacity-85 hover:opacity-100 transition-opacity duration-500" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
            </div>
        </div>

        <!-- Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8" data-aos="fade-up" data-aos-delay="200">
            
            <div class="glass-panel-strong p-6 text-center flex flex-col items-center group">
                <div class="icon-circle mb-4">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <h4 class="text-[#e8e6e3] font-bold text-sm mb-1">Dirección</h4>
                <p class="text-[#78716c] text-xs leading-relaxed">Av. Cuauhtémoc 776-Loc. G, Narvarte Poniente, Benito Juárez, 03020 Ciudad de México CDMX</p>
            </div>

            <div class="glass-panel-strong p-6 text-center flex flex-col items-center group">
                <div class="icon-circle mb-4">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h4 class="text-[#e8e6e3] font-bold text-sm mb-1">Horario</h4>
                <p class="text-[#78716c] text-xs leading-relaxed">Lun - Sáb: 10:00 - 20:00<br>Dom: 10:00 - 18:00</p>
            </div>

            <div class="glass-panel-strong p-6 text-center flex flex-col items-center group">
                <div class="icon-circle mb-4">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                </div>
                <h4 class="text-[#e8e6e3] font-bold text-sm mb-1">Contacto</h4>
                <p class="text-[#78716c] text-xs leading-relaxed">+52 246 141 5946<br>contacto@esteticaparis.com</p>
            </div>

        </div>
    </div>
</section>