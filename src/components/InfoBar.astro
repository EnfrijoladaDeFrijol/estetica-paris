---
// InfoBar — Franja compacta con Dirección, Horario y Contacto
---
<div class="relative py-10 px-6 overflow-hidden">
    <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8 lg:gap-12 text-center">
            
            <!-- Dirección -->
            <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-[#d4af37] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-[#78716c] text-xs leading-tight">Av. Cuauhtémoc 776-Loc. G, Narvarte Poniente, CDMX</span>
            </div>

            <!-- Separador -->
            <div class="hidden md:block w-px h-8 bg-white/10"></div>

            <!-- Horario -->
            <div class="flex items-start gap-3 mt-1 md:mt-0">
                <!-- Ícono de reloj (alineado arriba con mt-0.5) -->
                <svg class="w-4 h-4 text-[#d4af37] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <!-- Contenedor en Columna para apilar los días -->
                <div class="flex flex-col items-start gap-1">
                    <span class="text-[#78716c] text-xs">Lun-Sab: 10:00 - 20:00</span>
                    <span class="text-[#78716c] text-xs">Dom: 10:00 - 18:00</span>
                </div>
            </div>

            <!-- Separador -->
            <div class="hidden md:block w-px h-8 bg-white/10"></div>

            <!-- Contactos Oficiales -->
            <div class="flex flex-col items-center gap-1.5 mt-2 md:mt-0">
                <!-- Etiqueta de seguridad -->
                <span class="text-[#d4af37] text-[9px] uppercase tracking-[0.2em] font-bold bg-[#d4af37]/10 px-2 py-0.5 rounded-sm">
                    Únicos números oficiales
                </span>
                
                <!-- Contenedor en Columna para apilar los teléfonos -->
                <div class="flex flex-col items-start gap-1.5 mt-1">
                    
                    <!-- WhatsApp (Logo Oficial) -->
                    <div class="flex items-center gap-1.5">
                        <!-- SVG del Logo de WhatsApp -->
                        <svg class="w-4 h-4 text-[#d4af37] flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                        </svg>
                        <span class="text-[#78716c] text-xs"> +52 246 141 5946</span>
                    </div>

                    <!-- Local (Apilado directamente abajo) -->
                    <div class="flex items-center gap-1.5">
                        <!-- Ícono de teléfono tradicional -->
                        <svg class="w-4 h-4 text-[#d4af37] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        <span class="text-[#78716c] text-xs"> 55 554 338 75</span>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <!-- Línea decorativa inferior -->
    <div class="absolute bottom-0 left-[15%] right-[15%] h-px bg-gradient-to-r from-transparent via-[rgba(212,175,55,0.15)] to-transparent"></div>
</div>