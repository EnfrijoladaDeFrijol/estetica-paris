---
---

<section class="bg-[#111110] py-12 relative z-20">
    <!-- Línea divisora superior más sutil y centrada -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4/5 md:w-1/2 h-[1px] bg-gradient-to-r from-transparent via-[#e8d48b]/30 to-transparent"></div>
    
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-4 text-center">
            <!-- Stat 1 -->
            <div class="flex flex-col items-center justify-center space-y-3">
                <span class="text-3xl md:text-4xl font-serif font-semibold text-[#e8d48b] tracking-normal">+10</span>
                <span class="text-[10px] md:text-xs text-gray-200 uppercase tracking-[0.15em] md:tracking-[0.2em] font-medium">Años Exp.</span>
            </div>
            <!-- Stat 2 -->
            <div class="flex flex-col items-center justify-center space-y-3">
                <span class="text-3xl md:text-4xl font-serif font-semibold text-[#e8d48b] tracking-normal">+1k</span>
                <span class="text-[10px] md:text-xs text-gray-200 uppercase tracking-[0.15em] md:tracking-[0.2em] font-medium">Clientes</span>
            </div>
            <!-- Stat 3 -->
            <div class="flex flex-col items-center justify-center space-y-3">
                <span class="text-3xl md:text-4xl font-serif font-semibold text-[#e8d48b] tracking-normal">4.5</span>
                <span class="text-[10px] md:text-xs text-gray-200 uppercase tracking-[0.15em] md:tracking-[0.2em] font-medium">Estrellas</span>
            </div>
            <!-- Stat 4 -->
            <div class="flex flex-col items-center justify-center space-y-3">
                <span class="text-3xl md:text-4xl font-serif font-semibold text-[#e8d48b] tracking-normal">100%</span>
                <span class="text-[10px] md:text-xs text-gray-200 uppercase tracking-[0.15em] md:tracking-[0.2em] font-medium">Satisfacción</span>
            </div>
        </div>
    </div>

    <!-- Línea divisora inferior más sutil y centrada -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4/5 md:w-1/2 h-[1px] bg-gradient-to-r from-transparent via-[#e8d48b]/30 to-transparent"></div>
</section>
