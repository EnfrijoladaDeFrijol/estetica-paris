---
---
<section id="reservas" class="relative py-28 md:py-36 px-6 overflow-hidden section-glow-top">
    
    <div class="max-w-4xl mx-auto relative z-10 text-center">
        
        <div data-aos="fade-up">
            <h2 class="text-4xl md:text-5xl font-bold mb-14 text-gradient-accent">Reserva tu Espacio</h2>
        </div>

        <!-- Panel Glass del Widget -->
        <div class="glass-panel p-3 md:p-4 rounded-3xl relative overflow-hidden group" data-aos="zoom-in" data-aos-duration="1000">
            
            <!-- Shimmer -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[rgba(212,175,55,0.08)] to-transparent -translate-x-full group-hover:animate-[shimmer_2s_infinite] pointer-events-none z-20"></div>

            <div class="rounded-2xl h-96 w-full flex flex-col items-center justify-center relative z-10"
                 style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                
                <!-- Icono Calendario -->
                <div class="icon-circle mb-6 w-16 h-16">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>

                <p class="text-[#a8a29e] font-light text-base px-4 mb-2">
                    Aquí integraremos tu Widget de Citas
                </p>
                <p class="text-[#57534e] text-xs tracking-wider uppercase font-medium">
                    Setmore · Fresha · Próximamente
                </p>

            </div>
        </div>

    </div>

    <style>
        @keyframes shimmer {
            100% { transform: translateX(100%); }
        }
    </style>
</section>