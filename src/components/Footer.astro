---
// src/components/Footer.astro
---
<footer class="relative overflow-hidden border-t border-white/5" style="background: rgba(17,17,16,0.9);">
    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(212,175,55,0.03)] to-transparent pointer-events-none"></div>
    
    <div class="max-w-6xl mx-auto px-6 py-14 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-center gap-8">
            
            <div class="text-center md:text-left">
                <span class="text-xl font-bold tracking-[0.2em] text-gradient">ESTÉTICA PARÍS</span>
                <p class="text-[#57534e] text-sm mt-3 max-w-xs font-light leading-relaxed">Líderes profesionales en la Belleza.</p>
            </div>

            <div class="flex gap-4">

                <!-- FB -->
                <a href="https://www.facebook.com/share/17vpf2SbX8" class="w-10 h-10 rounded-xl flex items-center justify-center text-[#57534e] hover:text-[#d4af37] transition-all duration-300 glass-panel-strong">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>

        </div>
        
        <div class="mt-12 pt-6 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[11px] text-[#44403c] tracking-wider">
            <p>&copy; {new Date().getFullYear()} Estética París. Todos los derechos reservados.</p>
            <p class="mt-2 md:mt-0">Hecho con cariño en CDMX</p>
        </div>
    </div>
</footer>
