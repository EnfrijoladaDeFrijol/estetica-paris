---
import { Image } from 'astro:assets';
import corte1 from '../assets/images/corte1.jpg';
import silla from '../assets/images/silla.jpg';
import fondo2 from '../assets/images/fondo2.jpg';
---

<style>
    /* 1. Animación del fondo cruzado continua optimizada */
    .fondo-dinamico {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        animation: crossfade 15s infinite ease-in-out;
        /* OPTIMIZACIÓN CLAVE: Avisar a la GPU y separar en capas */
        will-change: opacity;
        transform: translate3d(0, 0, 0);
        backface-visibility: hidden;
    }
    .fondo-dinamico :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .fondo-dinamico:nth-child(1) { animation-delay: 0s; }
    .fondo-dinamico:nth-child(2) { animation-delay: 5s; }
    .fondo-dinamico:nth-child(3) { animation-delay: 10s; }
    
    @keyframes crossfade {
        0%, 100% { opacity: 0; transform: scale(1); }
        10%, 33% { opacity: 1; transform: scale(1.03); }
        43% { opacity: 0; transform: scale(1.06); }
    }

    /* 2. Efecto Panel Translúcido (Súper Ligero, Sin Blur para Móviles) */
    .nosotros-glass-panel {
        /* Usamos background-color en lugar de linear-gradient para una transición suave perfecta */
        background-color: rgba(22, 22, 20, 0.75);
        border: 1px solid rgba(212, 175, 55, 0.05);
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-left: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 2rem;
        box-shadow: 
            0 20px 50px rgba(0, 0, 0, 0.4),
            inset 0 1px 15px rgba(255, 255, 255, 0.01);
        
        /* Transición suave para el botón de ojito */
        transition: background-color 1s ease-in-out, box-shadow 1s ease-in-out, border 1s ease-in-out;
    }

    /* Overlay: transición gradual y suave */
    #nosotros-overlay {
        transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Estado cuando se activa el ojito: solo se aclara un poco para ver el fondo */
    .nosotros-glass-panel.glass-hidden {
        background-color: rgba(17, 17, 16, 0.25);
        border: 1px solid rgba(212, 175, 55, 0.08);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 
            0 20px 50px rgba(0, 0, 0, 0.2),
            inset 0 1px 15px rgba(255, 255, 255, 0.01);
        /* Blur eliminado para mayor limpieza visual y ver mejor las fotos */
    }

    /* Proteger legibilidad del texto cuando el panel está en modo "peek" */
    .nosotros-glass-panel.glass-hidden h2,
    .nosotros-glass-panel.glass-hidden p,
    .nosotros-glass-panel.glass-hidden span {
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
    }
</style>

<section class="relative py-28 md:py-36 px-6 flex items-center justify-center overflow-hidden section-glow-top" id="nosotros">
    
    <!-- 1. FOTOS DE FONDO -->
    <div class="absolute inset-0 z-0 bg-[#111110]">
        <div class="fondo-dinamico">
            <Image src={corte1} alt="Detalle 1" width={1200} height={800} format="webp" quality={40} loading="lazy" />
        </div>
        <div class="fondo-dinamico">
            <Image src={silla} alt="Detalle 2" width={1200} height={800} format="webp" quality={40} loading="lazy" />
        </div>
        <div class="fondo-dinamico">
            <Image src={fondo2} alt="Detalle 3" width={1200} height={800} format="webp" quality={40} loading="lazy" />
        </div>
    </div>

    <!-- 2. OVERLAY general -->
    <div id="nosotros-overlay" class="absolute inset-0 bg-gradient-to-b from-[#111110]/80 via-[#111110]/30 to-[#111110]/80 z-5 transition-opacity duration-700"></div>

    <!-- 3. CONTENIDO PRINCIPAL -->
    <div class="relative z-10 w-full max-w-5xl mx-auto" data-aos="fade-up" data-aos-duration="1000">
        
        <div id="nosotros-panel" class="nosotros-glass-panel p-10 md:p-16 flex flex-col items-center text-center transition-all duration-700 relative">
            
            <!-- Ojito discreto esquina superior derecha -->
            <button id="toggle-blur-btn" class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 cursor-pointer z-20 opacity-50 hover:opacity-100 bg-white/5 border border-white/10 hover:bg-white/10"
                    aria-label="Ver fotos" title="Ver fotos">
                <svg id="blur-icon" class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
            </button>
            
            <!-- Envolvemos el texto para poder ocultarlo fácil con el botón -->
            <div id="panel-content" class="transition-all duration-500 w-full flex flex-col items-center mt-6 md:mt-0">
                <!-- Título -->
                <h2 class="text-4xl md:text-5xl font-bold mb-6 text-[#e8d48b] tracking-wide">
                    Experiencia que se nota
                </h2>
                
                <!-- Texto (Aclarado a gray-300 para mayor contraste) -->
                <p class="text-gray-300 leading-relaxed text-lg max-w-3xl font-light">
                    Con años de experiencia perfeccionando su oficio, nuestro maestro barbero garantiza un trabajo impecable. Aquí no hay cortes genéricos, solo profesionalismo, tradición y atención absoluta al detalle.
                </p>
            </div>

        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('toggle-blur-btn');
        const overlay = document.getElementById('nosotros-overlay');
        const panel = document.getElementById('nosotros-panel');
        const panelContent = document.getElementById('panel-content');
        const icon = document.getElementById('blur-icon');
        let textVisible = true; // Por defecto el texto y el cristal son visibles

        if (btn && overlay && panel && panelContent) {
            btn.addEventListener('click', () => {
                textVisible = !textVisible;
                
                if (!textVisible) {
                    // Modo "Ver Fotos": Transición suave usando CSS class
                    panel.classList.add('glass-hidden');
                    overlay.style.opacity = '0.35'; // Más transparente para ver el fondo
                    
                    btn.title = 'Restaurar panel';
                    btn.style.opacity = '0.8';
                    // Cambia a icono de "Ojo cerrado"
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L6.59 6.59m7.532 7.532l3.29 3.29M3 3l18 18"></path>';
                } else {
                    // Modo "Leer Texto": Regresa a la normalidad usando la clase CSS
                    panel.classList.remove('glass-hidden');
                    overlay.style.opacity = '1';
                    
                    btn.title = 'Ver fotos';
                    btn.style.opacity = '';
                    // Regresa a icono de "Ojo abierto"
                    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
                }
            });
        }
    });
</script>