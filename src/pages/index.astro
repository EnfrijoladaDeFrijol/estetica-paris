---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Nosotros from '../components/Nosotros.astro';
import Equipo from '../components/Equipo.astro';
import InfoBar from '../components/InfoBar.astro';
import Servicios from '../components/Servicios.astro';
import GoldenBar from '../components/GoldenBar.astro';
import Productos from '../components/Productos.astro';
import Booking from '../components/Booking.astro';
import Resenas from '../components/Resenas.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Hero />
    <StatsBar />
    <Nosotros />
    <Servicios />
    <GoldenBar />
    <Productos />
    <!-- Separador elegante -->
    <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[#d4af37]/30 to-transparent my-0"></div>
    <Booking />
    <Equipo />
    <Resenas />
    <Ubicacion />
    <InfoBar />
    <Footer />
</Layout>