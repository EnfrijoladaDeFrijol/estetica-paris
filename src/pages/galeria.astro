---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

/* ── Datos de galería ── */

const trabajos = [
    { src: "https://images.unsplash.com/photo-1605497788044-5a32c7078486?w=600&h=750&fit=crop&q=80", titulo: "Fade Clásico", categoria: "Cortes" },
    { src: "https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=600&h=750&fit=crop&q=80", titulo: "Barba Esculpida", categoria: "Barba" },
    { src: "https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=600&h=900&fit=crop&q=80", titulo: "Corte Texturizado", categoria: "Cortes" },
    { src: "https://images.unsplash.com/photo-1521490683712-35a1cb235d1c?w=600&h=600&fit=crop&q=80", titulo: "Balayage Dorado", categoria: "Color" },
    { src: "https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=600&h=750&fit=crop&q=80", titulo: "Estilo Ejecutivo", categoria: "Cortes" },
    { src: "https://images.unsplash.com/photo-1621605815971-fbc98d665033?w=600&h=850&fit=crop&q=80", titulo: "Degradado Bajo", categoria: "Cortes" },
    { src: "https://images.unsplash.com/photo-1493256338651-d82f7acb2b38?w=600&h=700&fit=crop&q=80", titulo: "Acabado Premium", categoria: "Peinados" },
    { src: "https://images.unsplash.com/photo-1596728325395-481c60a33ccc?w=600&h=750&fit=crop&q=80", titulo: "Barba Perfilada", categoria: "Barba" },
    { src: "https://images.unsplash.com/photo-1560869713-7d0a29430803?w=600&h=850&fit=crop&q=80", titulo: "Mechas Sutiles", categoria: "Color" },
    { src: "https://images.unsplash.com/photo-1584297091422-42e3ad0c5d42?w=600&h=600&fit=crop&q=80", titulo: "Pompadour Clásico", categoria: "Peinados" },
    { src: "https://images.unsplash.com/photo-1634302086887-13b5281d6e74?w=600&h=750&fit=crop&q=80", titulo: "Skin Fade", categoria: "Cortes" },
    { src: "https://images.unsplash.com/photo-1517832606299-7ae9b720a186?w=600&h=700&fit=crop&q=80", titulo: "Barba Completa", categoria: "Barba" },
];
---

<Layout>

    <!-- ═══ HERO ═══ -->
    <section class="relative pt-40 pb-20 md:pt-48 md:pb-28 px-6 text-center overflow-hidden">
        <!-- Decorative glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.07),transparent_70%)] pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10 max-w-3xl mx-auto" data-aos="fade-up">
            <p class="text-[#d4af37] uppercase tracking-[0.3em] text-xs md:text-sm font-light mb-5">Estética París</p>
            <h1 class="text-5xl md:text-6xl lg:text-7xl text-gradient leading-tight mb-6">
                Galería de Trabajos
            </h1>
            <p class="text-gray-400 text-base md:text-lg font-light leading-relaxed max-w-xl mx-auto">
                Cada imagen refleja nuestro compromiso con la excelencia. Explora los estilos que definen a Estética París.
            </p>

            <!-- Botón Volver al inicio -->
            <div class="flex justify-center mt-10 md:mt-12" data-aos="fade-up" data-aos-delay="200">
                <a href="/#galeria" class="glass-btn group">
                    <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Volver al inicio
                </a>
            </div>
        </div>

        <!-- Separador dorado -->
        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[#d4af37]/25 to-transparent mt-20"></div>
    </section>


    <!-- ═══ GRID MASONRY ═══ -->
    <section class="px-6 pb-28 md:pb-36 mt-10">
        <div class="max-w-[90rem] w-full mx-auto" id="galeria-grid-container">
            <div class="galeria-masonry" id="galeria-grid">
                {trabajos.map((item, idx) => (
                    <div
                        class="galeria-card group"
                        data-categoria={item.categoria}
                        data-aos="fade-up"
                        data-aos-delay={String((idx % 4) * 80)}
                    >
                        <button
                            type="button"
                            class="galeria-card-inner relative rounded-2xl overflow-hidden cursor-pointer w-full border-0 p-0 bg-transparent"
                            data-lightbox-src={item.src.replace(/w=600/, 'w=1200').replace(/h=\d+/, 'h=1200')}
                            data-lightbox-titulo={item.titulo}
                            data-lightbox-categoria={item.categoria}
                            aria-label={`Ver ${item.titulo} en pantalla completa`}
                        >
                            <img
                                src={item.src}
                                alt={item.titulo}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-110 rounded-2xl"
                            />
                            <!-- Icono de expansión -->
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl flex items-center justify-center">
                                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-white/10 backdrop-blur-sm border border-white/20">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                                    </svg>
                                </div>
                            </div>
                        </button>
                    </div>
                ))}
            </div>
        </div>

        <!-- Mensaje vacío (oculto por defecto) -->
        <div id="galeria-empty" class="hidden text-center py-20 max-w-6xl mx-auto">
            <p class="text-gray-500 text-lg font-light">No hay trabajos en esta categoría por ahora.</p>
        </div>
    </section>


    <!-- ═══ LIGHTBOX MODAL ═══ -->
    <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 md:p-8" role="dialog" aria-modal="true" aria-label="Visor de imagen">
        <!-- Backdrop -->
        <div id="lightbox-backdrop" class="absolute inset-0 bg-[#111110]/90 backdrop-blur-xl transition-opacity duration-500 opacity-0"></div>

        <!-- Contenido -->
        <div id="lightbox-content" class="relative z-10 flex flex-col items-center max-w-5xl w-full max-h-[90vh] transition-all duration-500 scale-95 opacity-0">
            <!-- Botón cerrar -->
            <button id="lightbox-close" type="button" class="absolute -top-12 right-0 md:top-2 md:-right-12 w-10 h-10 rounded-full flex items-center justify-center bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 cursor-pointer z-20" aria-label="Cerrar visor">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Imagen -->
            <div class="w-full flex items-center justify-center overflow-hidden rounded-2xl border border-white/8 shadow-2xl bg-black/30">
                <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-2xl" />
            </div>

        </div>
    </div>
    </div>


    <Footer />
</Layout>


<style>
    /* ── Masonry Grid ── */
    .galeria-masonry {
        columns: 2;
        column-gap: 0.75rem;
    }

    @media (min-width: 640px) {
        .galeria-masonry { columns: 3; column-gap: 1rem; }
    }

    @media (min-width: 1024px) {
        .galeria-masonry { columns: 4; }
    }

    @media (min-width: 1280px) {
        .galeria-masonry { columns: 5; }
    }

    .galeria-card {
        break-inside: avoid;
        margin-bottom: 1rem;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .galeria-card.is-hidden {
        display: none;
    }

    .galeria-card-inner {
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
        transition: border-color 0.4s ease, box-shadow 0.4s ease;
        display: block;
    }

    .galeria-card-inner:hover {
        border-color: rgba(212, 175, 55, 0.2);
        box-shadow:
            0 12px 40px rgba(0, 0, 0, 0.4),
            0 0 30px rgba(212, 175, 55, 0.06);
    }

    .galeria-card-info {
        background: rgba(17, 17, 16, 0.65);
        backdrop-filter: blur(12px) saturate(1.3);
        -webkit-backdrop-filter: blur(12px) saturate(1.3);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }



    /* ── Lightbox ── */
    #lightbox.lightbox-open {
        display: flex;
    }

    #lightbox.lightbox-visible #lightbox-backdrop {
        opacity: 1;
    }

    #lightbox.lightbox-visible #lightbox-content {
        opacity: 1;
        transform: scale(1);
    }

    /* ── Mobile tweaks ── */
    @media (max-width: 767px) {
        .galeria-card-info {
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            background: rgba(17, 17, 16, 0.85);
        }

        /* Siempre visible en móvil */
        .galeria-card .absolute.inset-x-0 {
            transform: translateY(0);
            opacity: 1;
        }

        .galeria-card .absolute.top-3 {
            opacity: 1;
        }
    }
</style>


<script is:inline>
document.addEventListener('DOMContentLoaded', () => {




    /* ═══════════════════════════════════════
       LIGHTBOX
       ═══════════════════════════════════════ */
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitulo = document.getElementById('lightbox-titulo');
    const lightboxCategoria = document.getElementById('lightbox-categoria');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');

    function openLightbox(src, titulo, categoria) {
        if (!lightbox || !lightboxImg) return;

        lightboxImg.src = src;
        lightboxImg.alt = titulo;

        // Prevent body scroll
        document.body.style.overflow = 'hidden';

        // Show modal
        lightbox.classList.add('lightbox-open');
        // Trigger animation (rAF for repaint)
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                lightbox.classList.add('lightbox-visible');
            });
        });
    }

    function closeLightbox() {
        if (!lightbox) return;

        lightbox.classList.remove('lightbox-visible');

        // Wait for animation to complete before hiding
        setTimeout(() => {
            lightbox.classList.remove('lightbox-open');
            document.body.style.overflow = '';
            if (lightboxImg) lightboxImg.src = '';
        }, 500);
    }

    // Bind click events to gallery cards
    document.querySelectorAll('[data-lightbox-src]').forEach(btn => {
        btn.addEventListener('click', () => {
            const src = btn.getAttribute('data-lightbox-src');
            const titulo = btn.getAttribute('data-lightbox-titulo');
            const categoria = btn.getAttribute('data-lightbox-categoria');
            openLightbox(src, titulo, categoria);
        });
    });

    // Close button
    if (lightboxClose) {
        lightboxClose.addEventListener('click', closeLightbox);
    }

    // Close on backdrop click
    if (lightboxBackdrop) {
        lightboxBackdrop.addEventListener('click', closeLightbox);
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox && lightbox.classList.contains('lightbox-open')) {
            closeLightbox();
        }
    });

});
</script>
