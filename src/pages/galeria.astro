---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import { Image } from 'astro:assets';

/* ── Datos de galería ── */
const imagesGlob = import.meta.glob('../assets/images/galeria/*.{jpeg,jpg,png,webp}', { eager: true });

const trabajos = Object.entries(imagesGlob)
    .sort(([pathA], [pathB]) => {
        const numA = parseInt(pathA.match(/\/(\d+)\./)?.[1] || '0');
        const numB = parseInt(pathB.match(/\/(\d+)\./)?.[1] || '0');
        return numA - numB;
    })
    .map(([path, img], index) => ({
        src: (img as any).default,
        titulo: `Trabajo ${index + 1}`,
        categoria: "Galería"
    }));
---

<Layout>

    <!-- ═══ HERO ═══ -->
    <section class="relative pt-40 pb-20 md:pt-48 md:pb-28 px-6 text-center overflow-hidden">
        <!-- Decorative glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.07),transparent_70%)] pointer-events-none" aria-hidden="true"></div>

        <div class="relative z-10 max-w-3xl mx-auto" data-aos="fade-up">
            <p class="text-[#d4af37] uppercase tracking-[0.3em] text-xs md:text-sm font-light mb-5">Estética París</p>
            <h1 class="text-5xl md:text-6xl lg:text-7xl text-gradient leading-tight mb-6">
                Galería de Trabajos
            </h1>
            <p class="text-gray-400 text-base md:text-lg font-light leading-relaxed max-w-xl mx-auto">
                Cada imagen refleja nuestro compromiso con la excelencia. Explora los estilos que definen a Estética París.
            </p>

            <!-- Botón Volver al inicio -->
            <div class="flex justify-center mt-10 md:mt-12" data-aos="fade-up" data-aos-delay="200">
                <a href="/#galeria" class="glass-btn group">
                    <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Volver al inicio
                </a>
            </div>
        </div>

        <!-- Separador dorado -->
        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[#d4af37]/25 to-transparent mt-20"></div>
    </section>


    <!-- ═══ GRID DINÁMICO ═══ -->
    <section class="px-4 sm:px-6 pb-28 md:pb-36 mt-10">
        <div class="max-w-[90rem] w-full mx-auto" id="galeria-grid-container">
            <div class="galeria-grid-dynamic" id="galeria-grid">
                {trabajos.map((item, idx) => (
                    <div
                        class="galeria-card galeria-tilt group"
                        data-categoria={item.categoria}
                        data-aos="fade-up"
                        data-aos-delay={String((idx % 5) * 90)}
                    >
                        <button
                            type="button"
                            class="galeria-card-inner relative overflow-hidden cursor-pointer w-full h-full border-0 p-0 bg-transparent"
                            data-lightbox-src={item.src.src}
                            data-lightbox-titulo={item.titulo}
                            data-lightbox-categoria={item.categoria}
                            aria-label={`Ver ${item.titulo} en pantalla completa`}
                        >
                            <Image
                                src={item.src}
                                alt={item.titulo}
                                width={600}
                                format="webp"
                                quality={85}
                                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                            />
                            <!-- Overlay social + expand -->
                            <div class="galeria-card-overlay">
                                <!-- Centro: ícono de expansión -->
                                <div class="galeria-expand-circle">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                                    </svg>
                                </div>
                                <!-- Bottom: corazón + título -->
                                <div class="galeria-card-info-bar">
                                    <svg class="w-4 h-4 text-white/80 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                    </svg>
                                    <span class="text-white/75 text-xs font-light tracking-wide">{item.titulo}</span>
                                </div>
                            </div>
                            <!-- Golden shimmer sweep -->
                            <div class="galeria-card-shimmer"></div>
                        </button>
                    </div>
                ))}
            </div>
        </div>

        <!-- Mensaje vacío (oculto por defecto) -->
        <div id="galeria-empty" class="hidden text-center py-20 max-w-6xl mx-auto">
            <p class="text-gray-500 text-lg font-light">No hay trabajos en esta categoría por ahora.</p>
        </div>

        <!-- Botón Volver al inicio (bottom) -->
        <div class="flex justify-center mt-16 md:mt-20" data-aos="fade-up">
            <a href="/#galeria" class="glass-btn group">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Volver al inicio
            </a>
        </div>
    </section>


    <!-- ═══ LIGHTBOX MODAL ═══ -->
    <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 md:p-8" role="dialog" aria-modal="true" aria-label="Visor de imagen">
        <!-- Backdrop -->
        <div id="lightbox-backdrop" class="absolute inset-0 bg-[#111110]/90 backdrop-blur-xl transition-opacity duration-500 opacity-0"></div>

        <!-- Contenido -->
        <div id="lightbox-content" class="relative z-10 flex flex-col items-center max-w-5xl w-full max-h-[90vh] transition-all duration-500 scale-95 opacity-0">
            <!-- Botón cerrar -->
            <button id="lightbox-close" type="button" class="absolute -top-12 right-0 md:top-2 md:-right-12 w-10 h-10 rounded-full flex items-center justify-center bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 transition-all duration-300 cursor-pointer z-20" aria-label="Cerrar visor">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Imagen -->
            <div class="w-full flex items-center justify-center overflow-hidden rounded-2xl border border-white/8 shadow-2xl bg-black/30">
                <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-2xl" />
            </div>

        </div>
    </div>
    </div>


    <Footer />
</Layout>


<style>
    /* ══════════════════════════════════════
       GRID DINÁMICO — Pinterest × Instagram
       CSS Grid con pattern de items destacados
       ══════════════════════════════════════ */
    .galeria-grid-dynamic {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-auto-rows: 220px;
        grid-auto-flow: dense;
        gap: 0.65rem;
    }

    @media (min-width: 640px) {
        .galeria-grid-dynamic {
            grid-template-columns: repeat(3, 1fr);
            grid-auto-rows: 230px;
            gap: 0.85rem;
        }
    }

    @media (min-width: 1024px) {
        .galeria-grid-dynamic {
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: 210px;
            gap: 1rem;
        }
    }

    @media (min-width: 1280px) {
        .galeria-grid-dynamic {
            grid-template-columns: repeat(5, 1fr);
            grid-auto-rows: 190px;
        }
    }

    /* ── Patrón de items destacados ── */
    /* "Hero" items: cada 7 → grande (2×2) */
    .galeria-grid-dynamic .galeria-card:nth-child(7n+1) {
        grid-column: span 2;
        grid-row: span 2;
    }

    /* "Tall" items: cada 7 offset +4 → alto (1×2) */
    .galeria-grid-dynamic .galeria-card:nth-child(7n+4) {
        grid-row: span 2;
    }

    /* En móvil, solo tall, nunca wide (previene overflow) */
    @media (max-width: 639px) {
        .galeria-grid-dynamic .galeria-card:nth-child(7n+1) {
            grid-column: span 1;
            grid-row: span 2;
        }
    }

    /* ══════════════════════════════════════
       TARJETAS — Base
       ══════════════════════════════════════ */
    .galeria-card {
        transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d;
        will-change: transform;
    }

    .galeria-card.is-hidden {
        display: none;
    }

    .galeria-card-inner {
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
        transition: border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        display: block;
    }

    /* ── Border-radius orgánico dinámico ── */
    .galeria-card:nth-child(4n+1) .galeria-card-inner { border-radius: 1.4rem 0.6rem 1.4rem 0.6rem; }
    .galeria-card:nth-child(4n+2) .galeria-card-inner { border-radius: 0.6rem 1.4rem 0.6rem 1.4rem; }
    .galeria-card:nth-child(4n+3) .galeria-card-inner { border-radius: 1rem 1rem 0.5rem 1.4rem; }
    .galeria-card:nth-child(4n+4) .galeria-card-inner { border-radius: 0.5rem 1.4rem 1rem 1rem; }

    /* Imágenes: heredar border-radius del padre */
    .galeria-card-inner img {
        border-radius: inherit;
    }

    /* ── Rotaciones sutiles (solo desktop) ── */
    @media (min-width: 768px) {
        .galeria-card:nth-child(5n+1) { transform: rotate(-0.6deg); }
        .galeria-card:nth-child(5n+2) { transform: rotate(0.4deg); }
        .galeria-card:nth-child(5n+3) { transform: rotate(-0.3deg); }
        .galeria-card:nth-child(5n+4) { transform: rotate(0.7deg); }
        .galeria-card:nth-child(5n+5) { transform: rotate(-0.5deg); }
    }

    /* ── Hover ── */
    .galeria-card-inner:hover {
        border-color: rgba(212, 175, 55, 0.3);
        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.5),
            0 0 40px rgba(212, 175, 55, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* ══════════════════════════════════════
       OVERLAY — Social style
       ══════════════════════════════════════ */
    .galeria-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top,
            rgba(0, 0, 0, 0.7) 0%,
            rgba(0, 0, 0, 0.15) 40%,
            transparent 65%);
        opacity: 0;
        transition: opacity 0.45s ease;
        border-radius: inherit;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .galeria-card:hover .galeria-card-overlay {
        opacity: 1;
    }

    .galeria-expand-circle {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transform: scale(0.7);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .galeria-card:hover .galeria-expand-circle {
        transform: scale(1);
        opacity: 1;
    }

    .galeria-card-info-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.85rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transform: translateY(8px);
        opacity: 0;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.4s ease;
    }

    .galeria-card:hover .galeria-card-info-bar {
        transform: translateY(0);
        opacity: 1;
    }

    /* ══════════════════════════════════════
       SHIMMER — Barrido dorado
       ══════════════════════════════════════ */
    .galeria-card-shimmer {
        position: absolute;
        top: 0;
        left: -60%;
        width: 40%;
        height: 100%;
        background: linear-gradient(
            105deg,
            transparent 20%,
            rgba(212, 175, 55, 0.08) 45%,
            rgba(212, 175, 55, 0.12) 50%,
            rgba(212, 175, 55, 0.08) 55%,
            transparent 80%
        );
        pointer-events: none;
        border-radius: inherit;
        opacity: 0;
    }

    .galeria-card:hover .galeria-card-shimmer {
        animation: shimmerSweepFull 0.9s ease-out forwards;
    }

    @keyframes shimmerSweepFull {
        0% { left: -60%; opacity: 1; }
        100% { left: 160%; opacity: 0; }
    }

    /* ══════════════════════════════════════
       MOBILE — Optimizaciones
       ══════════════════════════════════════ */
    @media (max-width: 767px) {
        .galeria-card-overlay {
            display: none;
        }
        .galeria-card-shimmer {
            display: none;
        }
        .galeria-card-inner {
            border-radius: 1rem !important;
        }
        .galeria-card-inner img {
            border-radius: 1rem !important;
        }
        .galeria-expand-circle {
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
        }
    }


    /* ══════════════════════════════════════
       LIGHTBOX
       ══════════════════════════════════════ */
    #lightbox.lightbox-open {
        display: flex;
    }

    #lightbox.lightbox-visible #lightbox-backdrop {
        opacity: 1;
    }

    #lightbox.lightbox-visible #lightbox-content {
        opacity: 1;
        transform: scale(1);
    }
</style>


<script is:inline>
document.addEventListener('DOMContentLoaded', () => {


    /* ═══════════════════════════════════════
       LIGHTBOX
       ═══════════════════════════════════════ */
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitulo = document.getElementById('lightbox-titulo');
    const lightboxCategoria = document.getElementById('lightbox-categoria');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');

    function openLightbox(src, titulo, categoria) {
        if (!lightbox || !lightboxImg) return;

        lightboxImg.src = src;
        lightboxImg.alt = titulo;

        // Prevent body scroll
        document.body.style.overflow = 'hidden';

        // Show modal
        lightbox.classList.add('lightbox-open');
        // Trigger animation (rAF for repaint)
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                lightbox.classList.add('lightbox-visible');
            });
        });
    }

    function closeLightbox() {
        if (!lightbox) return;

        lightbox.classList.remove('lightbox-visible');

        // Wait for animation to complete before hiding
        setTimeout(() => {
            lightbox.classList.remove('lightbox-open');
            document.body.style.overflow = '';
            if (lightboxImg) lightboxImg.src = '';
        }, 500);
    }

    // Bind click events to gallery cards
    document.querySelectorAll('[data-lightbox-src]').forEach(btn => {
        btn.addEventListener('click', () => {
            const src = btn.getAttribute('data-lightbox-src');
            const titulo = btn.getAttribute('data-lightbox-titulo');
            const categoria = btn.getAttribute('data-lightbox-categoria');
            openLightbox(src, titulo, categoria);
        });
    });

    // Close button
    if (lightboxClose) {
        lightboxClose.addEventListener('click', closeLightbox);
    }

    // Close on backdrop click
    if (lightboxBackdrop) {
        lightboxBackdrop.addEventListener('click', closeLightbox);
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox && lightbox.classList.contains('lightbox-open')) {
            closeLightbox();
        }
    });


    /* ═══════════════════════════════════════
       TILT 3D — Efecto holográfico al hover
       Solo desktop
       ═══════════════════════════════════════ */
    if (window.innerWidth >= 768) {
        var tiltCards = document.querySelectorAll('.galeria-tilt');
        tiltCards.forEach(function(card) {
            card.addEventListener('mousemove', function(e) {
                var rect = card.getBoundingClientRect();
                var x = e.clientX - rect.left;
                var y = e.clientY - rect.top;
                var cx = rect.width / 2;
                var cy = rect.height / 2;
                var rotateX = ((y - cy) / cy) * -5;
                var rotateY = ((x - cx) / cx) * 5;

                card.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) scale(1.03)';
                card.style.transition = 'transform 0.1s ease-out, border-color 0.5s, box-shadow 0.5s';
            });

            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
                card.style.transition = '';
            });
        });
    }

});
</script>
